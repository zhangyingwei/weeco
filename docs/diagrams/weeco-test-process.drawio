        <mxCell id="N1" value="老板协调原则&#xa;只做澄清、合同、招团队、等待、验收、&#xa;推进阶段；不写设计 / 计划 / 代码。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#d79b00;fontSize=10;fontColor=#5a4214;dashed=1;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="435" width="260" height="95" as="geometry" />
        </mxCell>
        <mxCell id="N3" value="老板验收方式&#xa;读合同 / result → 独立复跑 pytest / tsc / 静态检查&#xa;→ 查证据 / hash / 范围 → accept，或 rework 退回原团队。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#d79b00;fontSize=9;fontColor=#5a4214;dashed=1;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="910" y="435" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="N2" value="严重异常 C：T-03 23:13 提交后，老板 21 分钟没反应。&#xa;原因：team wait 把负责人 idle 当结束，submit 没人监听。&#xa;修复：0.8.1 轮询团队状态直到 submitted / blocked / lost / 超时。&#xa;修复后：T-04 26 秒、T-05 79 秒内被验收。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;fontSize=9;fontColor=#5c1a1a;dashed=1;strokeWidth=2;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1880" y="435" width="300" height="95" as="geometry" />
        </mxCell>

