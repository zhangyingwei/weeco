        <mxCell id="I9" value="文件所有权隔离&#xa;周砚只写 backend/app；&#xa;顾行舟只写 frontend；&#xa;沈清越只写 tests/README；跨模块只读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eaf8;strokeColor=#9673a6;fontSize=9;fontColor=#2e1a3a;dashed=1;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
